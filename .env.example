# ==============================================================================
# MergeID environment configuration
# Copy to .env and fill in real values. NEVER commit .env files.
# Full reference: docs/configuration.md
# ==============================================================================

# --- Discord -------------------------------------------------------------
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application (client) ID of the same Discord application
DISCORD_CLIENT_ID=
# Optional: register slash commands to a single dev guild for instant updates
DISCORD_DEV_GUILD_ID=

# --- GitHub OAuth app (https://github.com/settings/developers) ------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must exactly match the callback URL registered on the GitHub OAuth app
OAUTH_REDIRECT_URI=https://bot.example.com/oauth/callback
# Scopes requested at link time (base set; rules may escalate per-user)
GITHUB_BASE_SCOPES=read:user,read:org

# --- HTTP server -----------------------------------------------------------
PORT=3000
# Public origin the OAuth callback is served from (used to build state/links)
PUBLIC_BASE_URL=https://bot.example.com

# --- Datastores -------------------------------------------------------------
DATABASE_URL=postgresql://mergeid:mergeid@localhost:5432/mergeid
REDIS_URL=redis://localhost:6379

# --- Container stack only (docker/compose.prod.yml) ---------------------------
# Not read by the application. compose builds DATABASE_URL/REDIS_URL from these
# unless you set those explicitly. See docs/configuration.md §1.
POSTGRES_DB=mergeid
POSTGRES_USER=mergeid
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Host interface/port the bot's HTTP port publishes on. Default 0.0.0.0:$PORT.
# Set 127.0.0.1 when a reverse proxy on the same host terminates TLS.
HTTP_BIND_HOST=0.0.0.0
HTTP_PUBLISHED_PORT=3000

# --- Security ---------------------------------------------------------------
# 32-byte hex key used for AES-256-GCM encryption of stored GitHub tokens.
# Generate with: openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
TOKEN_ENCRYPTION_KEY=

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Which runtime roles this process serves: comma-separated subset of bot,api,worker
# Single-process default runs all three; split them when scaling (docs/architecture.md §4)
MERGEID_ROLES=bot,api,worker
