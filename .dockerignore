# Version control and CI metadata
.git
.github

# Dependencies, build products, and generated code
node_modules
.pnpm-store
dist
src/generated
*.tsbuildinfo

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Tests and documentation. README/LICENSE stay in the image so it carries its
# own provenance (LICENSE has no extension, so *.md never matched it).
test
tests
docs
*.md
!README.md

# Editor, coverage, and log artifacts
.idea
.vscode
*.swp
*.swo
*~
coverage
.nyc_output
*.log

# Compose files orchestrate the image; they are never needed inside it
docker/compose.dev.yaml
docker/compose.prod.yml
