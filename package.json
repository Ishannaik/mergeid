{
  "name": "mergeid",
  "version": "0.0.0",
  "private": true,
  "description": "MergeID — Discord bot that securely links and verifies GitHub accounts with Discord accounts.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "prisma generate && tsc",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "start": "node dist/index.js",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^17.9.0",
    "prettier": "^3.6.0",
    "prisma": "^7.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bullmq": "^6.0.9",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
